{
  "name": "@robolab/backend",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "RoboLab: backend en Convex, dominio compartido (reglas del juego y de la evaluación) y robot por wifi.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orinqq/robolab-backend.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "convex",
    "domain",
    "generation"
  ],
  "exports": {
    "./convex/_generated/api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./convex/_generated/dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./domain/*": "./domain/*.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "setup": "node scripts/setup.mjs",
    "robot:simulador": "node scripts/robot-sim.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:firmware",
    "test:firmware": "node --test scripts/bundle-firmware.test.mjs && node scripts/bundle-firmware.mjs --check && node scripts/test-firmware.mjs",
    "firmware:bundle": "node scripts/bundle-firmware.mjs"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.96",
    "convex": "1.47.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "convex-test": "0.0.62",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
